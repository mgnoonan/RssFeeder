        "FilterDuplicates": false
      },
      {
        "SectionName": "above the fold",
        "ContainerSelector": "ul.wpd-top-links",
        "LinkSelector": "a",
        "FilterDuplicates": false
      },
      {
        "SectionName": "column 1",
        "ContainerSelector": "#column-1 > div > div.wpd-posted-links",
        "LinkSelector": "a",
        "FilterDuplicates": false
      },
      {
        "SectionName": "column 2",
        "ContainerSelector": "#column-2 > div > div.wpd-posted-links",
        "LinkSelector": "a",
        "FilterDuplicates": false
      }
    ]
  }
]
