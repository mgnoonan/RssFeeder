[
  {
    "Title": "Twitchy",
    "Enabled": "true",
    "EnableThumbnail": "false",
    "Exportable": "false",
    "Description": "Twitchy",
    "Language": "en-US",
    "Url": "https://www.twitchy.com/",
    "CustomParser": "RssFeeder.Console.FeedBuilders.TwitchyFeedBuilder",
    "CollectionName": "twitchy",
    "FileRetentionDays": 3,
    "DatabaseRetentionDays": 180,
    "Filters": [],
    "Sections": [
      {
        "SectionName": "headlines",
        "ContainerSelector": "section.pt-2",
        "LinkSelector": "div.wp-card-huge__title > a",
        "FilterDuplicates": false
      },
      {
        "SectionName": "above the fold",
        "ContainerSelector": "body>main>section:nth-child(2)",
        "LinkSelector": "div.wp-card__title > a",
        "FilterDuplicates": false
      },
      {
        "SectionName": "posts",
        "ContainerSelector": "#post-list",
        "LinkSelector": "div.wp-card__title > a",
        "FilterDuplicates": false
      }
    ]
  }
]
